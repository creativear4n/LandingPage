<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: selalu validasi versi terbaru
    ExpiresByType text/html "access plus 0 seconds"

    # CSS dan JavaScript yang tidak memiliki hash
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"

    # Images
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/gif "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
    ExpiresByType image/avif "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 1 day"
    ExpiresByType image/x-icon "access plus 1 day"

    # Fonts
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
    ExpiresByType application/vnd.ms-fontobject "access plus 30 days"

    # Videos
    ExpiresByType video/mp4 "access plus 1 day"
    ExpiresByType video/webm "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>

    # index.html harus memeriksa versi terbaru
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>

    # Vite hashed JS dan CSS:
    # Simpan hingga satu tahun karena nama file berubah
    # ketika kontennya berubah.
    <FilesMatch "[-][A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # Fonts
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Videos
    <FilesMatch "\.(mp4|webm|mov)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect HTTP dan WWW ke HTTPS non-WWW
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.ar4n\.com$ [NC]
    RewriteRule ^ https://ar4n.com%{REQUEST_URI} [R=301,L]

    # Jangan rewrite index.html
    RewriteRule ^index\.html$ - [L]

    # Pertahankan file dan direktori yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React SPA fallback
    RewriteRule . /index.html [L]
</IfModule>
